# Ignopticon modelling image: ELMFIRE (gfortran + Open MPI), GDAL's command-line tools, and a Python venv with
# every package scripts/ needs (the ELMFIRE pipeline and the training stage), plus uv so the scripts' own
# `uv run --script` shebangs also work. The scripts are NOT baked in: bind-mount the repo at run time.
# The same image runs here (podman) and on Tillicum (Apptainer).
#
# Build (here):  podman build -t ignopticon-model -f hyak/Containerfile hyak
# Export:        podman save --format docker-archive -o hyak/ignopticon-model.tar ignopticon-model
# On Tillicum:   see hyak/README.md (apptainer build ... docker-archive://hyak/ignopticon-model.tar)
# Run here:      podman run --rm -v "$PWD:$PWD" -w "$PWD" ignopticon-model scripts/elmfire_forecast.sh ...
FROM ghcr.io/astral-sh/uv:0.9 AS uv
FROM docker.io/library/ubuntu:24.04

# ELMFIRE commit tested here (tools/elmfire, 2026-11-14). Its Makefile builds with -march=native; the image
# replaces that with ELMFIRE_MARCH so a binary built on this Ryzen also runs on Tillicum's Intel nodes.
ARG ELMFIRE_REF=f4927b7
ARG ELMFIRE_MARCH=x86-64-v3
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        gfortran openmpi-bin libopenmpi-dev make git ca-certificates \
        gdal-bin python3 python3-venv libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Union of the scripts' "# dependencies" lines, plus pandas/pyarrow for the training stage.
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir \
        numpy scipy h5py pyproj rasterio "shapely>=2.1" netCDF4 pillow pygrib pyhdf \
        lightgbm scikit-learn pandas pyarrow
ENV PATH=/opt/venv/bin:$PATH

COPY --from=uv /uv /uvx /usr/local/bin/

# ELMFIRE's fast build (main executable only): bin/elmfire_1.1 with an "elmfire" symlink.
RUN git clone https://github.com/lautenberger/elmfire.git /opt/elmfire \
    && cd /opt/elmfire && git checkout "$ELMFIRE_REF" \
    && cd build/linux && sed -i "s/-march=native/-march=$ELMFIRE_MARCH/" Makefile_elmfire \
    && mkdir -p bin && ./make_gnu.sh fast \
    && ls -l bin && test -x bin/elmfire \
    && ln -sf /opt/elmfire/build/linux/bin/elmfire /usr/local/bin/elmfire

# Defaults the repo's scripts read: the ELMFIRE binary, and run Python scripts with the venv's python3
# instead of their uv shebangs (scripts/elmfire_forecast.sh: PY; scripts/run_member.sh: RUN_PY).
ENV ELMFIRE_BASE_DIR=/opt/elmfire ELMFIRE=/opt/elmfire/build/linux/bin/elmfire PY=python3 RUN_PY=python3
# Open MPI refuses to run as root in a container unless told it may (podman runs as root inside).
ENV OMPI_ALLOW_RUN_AS_ROOT=1 OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1
WORKDIR /work
